            </g>
          ))}
          {svgLines.map(l => {
            const isActive = activeRel === l.key; const isHovered = hoveredRel === l.key; const hl = isActive || isHovered;
            const pathStr = pointsToAngularPath(l.points);
            const L = 8;
            const pts = l.points;
            let markerD = '';
            if (pts.length >= 2) {
              const p0 = pts[0], p1 = pts[1], pn = pts[pts.length - 2], pp = pts[pts.length - 1];
              const aStart = Math.atan2(p1.y - p0.y, p1.x - p0.x);
              const aEnd = Math.atan2(pp.y - pn.y, pp.x - pn.x);
              const [sx, sy] = [Math.cos(aStart), Math.sin(aStart)];
              const [ex, ey] = [Math.cos(aEnd), Math.sin(aEnd)];
              const [psx, psy] = [Math.cos(aStart + Math.PI / 2), Math.sin(aStart + Math.PI / 2)];
              const [pex, pey] = [Math.cos(aEnd + Math.PI / 2), Math.sin(aEnd + Math.PI / 2)];
              if (l.startMarker === 'one') markerD += `M${(p0.x + psx * L * 0.7).toFixed(1)},${(p0.y + psy * L * 0.7).toFixed(1)} L${(p0.x - psx * L * 0.7).toFixed(1)},${(p0.y - psy * L * 0.7).toFixed(1)} `;
              if (l.startMarker === 'many') { const f = L * 0.7, s = L * 0.7; const cx = p0.x + sx * f, cy = p0.y + sy * f; markerD += `M${(p0.x + psx * s).toFixed(1)},${(p0.y + psy * s).toFixed(1)} L${cx.toFixed(1)},${cy.toFixed(1)} M${(p0.x - psx * s).toFixed(1)},${(p0.y - psy * s).toFixed(1)} L${cx.toFixed(1)},${cy.toFixed(1)} M${p0.x},${p0.y} L${cx.toFixed(1)},${cy.toFixed(1)} `; }
              if (l.endMarker === 'one') markerD += `M${(pp.x + pex * L * 0.7).toFixed(1)},${(pp.y + pey * L * 0.7).toFixed(1)} L${(pp.x - pex * L * 0.7).toFixed(1)},${(pp.y - pey * L * 0.7).toFixed(1)} `;
              if (l.endMarker === 'many') { const f = L * 0.7, s = L * 0.7; const cx = pp.x - ex * f, cy = pp.y - ey * f; markerD += `M${(pp.x + pex * s).toFixed(1)},${(pp.y + pey * s).toFixed(1)} L${cx.toFixed(1)},${cy.toFixed(1)} M${(pp.x - pex * s).toFixed(1)},${(pp.y - pey * s).toFixed(1)} L${cx.toFixed(1)},${cy.toFixed(1)} M${pp.x},${pp.y} L${cx.toFixed(1)},${cy.toFixed(1)} `; }
            }
            return (
              <g key={l.key}>
                <path d={pathStr} stroke="transparent" strokeWidth={hl ? 28 : 20} fill="none" style={{ pointerEvents: 'stroke', cursor: 'pointer', transition: 'stroke-width 0.35s ease' }}
                  onMouseDown={e => { if (isActive) handleLineMouseDown(e, l.key, l.points); else setActiveRel(l.key); if (pulseTimeoutRef.current) clearTimeout(pulseTimeoutRef.current); setPulseRel(l.key); pulseTimeoutRef.current = setTimeout(() => setPulseRel(null), 2400); }}
                  onMouseEnter={() => setHoveredRel(l.key)} onMouseLeave={() => setHoveredRel(h => h === l.key ? null : h)} />
                <path d={pathStr} stroke="#ffffff" strokeWidth={hl ? 2.5 : 1.5} strokeLinecap="round" strokeLinejoin="round" opacity={hl ? 0.85 : 0.5} fill="none" style={{ pointerEvents: 'none', transition: 'opacity 0.4s ease, stroke-width 0.4s ease' }} />
                <path d={pathStr} stroke="#ffffff" strokeWidth={4} fill="none" filter="url(#glow)" opacity={hl ? 0.3 : 0} style={{ pointerEvents: 'none', transition: 'opacity 0.5s ease' }} />
                <path d={pathStr} stroke="#ffffff" strokeWidth={hl ? 4 : 3} strokeDasharray="0, 10" strokeLinecap="round" opacity={hl ? 0.7 : 0.4} fill="none" style={{ pointerEvents: 'none', transition: 'opacity 0.4s ease, stroke-width 0.4s ease' }} />
                {markerD && <path d={markerD} stroke="#ffffff" strokeWidth={hl ? 2.2 : 1.8} strokeLinecap="round" strokeLinejoin="round" opacity={hl ? 0.85 : 0.5} fill="none" style={{ pointerEvents: 'none' }} />}
                {(isActive || isHovered) && l.points.map((p, pi) => {
                  const isEp = pi === 0 || pi === l.points.length - 1;
                  return (<g key={`h-${pi}`}>
                    <circle cx={p.x} cy={p.y} r={isEp ? 4 : 5} fill={isEp ? '#ffffff' : '#c4b5fd'} stroke={isEp ? '#4f46e5' : '#a371f7'} strokeWidth={isEp ? 1.5 : 2} opacity={1}
                      filter={!isEp ? 'url(#glow)' : undefined} style={{ cursor: 'grab', pointerEvents: 'all' }}
                      onMouseDown={e => handleWpMouseDown(e, l.key, pi)} onDoubleClick={e => handleWaypointDblClick(e, l.key, pi, l.points)} />
                    {!isEp && <circle cx={p.x} cy={p.y} r={2.5} fill="#7c3aed" opacity={0.6} style={{ pointerEvents: 'none' }} />}
                  </g>);
                })}
              </g>
            );
          })}
        </svg>
        {activeLayerId && (() => {
          const layer = layers.find(l => l.id === activeLayerId); if (!layer) return null;
          const px = pan.x + (layer.x + layer.w / 2) * zoom; const py = pan.y + layer.y * zoom - 8;
          return (<div className="absolute z-30" style={{ left: px, top: py, transform: 'translate(-50%, -100%)' }} onMouseDown={e => e.stopPropagation()}>
            <div className="bg-[#21262d]/95 backdrop-blur-sm border border-[#30363d]/60 rounded-xl shadow-2xl p-3 min-w-[210px]" style={{ borderLeftColor: layer.color, borderLeftWidth: '3px' }}>
              <div className="flex items-center gap-2 mb-2.5">
                <div className="w-3 h-3 rounded-full shrink-0 shadow-sm" style={{ backgroundColor: layer.color }} />
                <input value={layer.name} onChange={e => onUpdateLayer(layer.id, { name: e.target.value })} onClick={e => e.stopPropagation()} className="flex-1 bg-transparent text-[13px] text-[#c9d1d9] font-semibold focus:outline-none focus:text-white" />
                <button onClick={() => setActiveLayerId(null)} className="text-[#6e7681] hover:text-[#c9d1d9] p-1 rounded-md hover:bg-[#30363d]/50"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
              </div>
              <div className="flex items-center gap-3 mb-2.5 p-2 bg-[#161b22]/80 rounded-lg">
                <div className="flex items-center gap-1.5"><input type="color" value={layer.color} onChange={e => onUpdateLayer(layer.id, { color: e.target.value })} className="w-5 h-5 rounded cursor-pointer border-0 p-0" /><span className="text-[10px] text-[#6e7681]">Color</span></div>
                <div className="w-px h-4 bg-[#30363d]" />
                <button onClick={e => { e.stopPropagation(); onUpdateLayer(layer.id, { visible: !(layer.visible !== false) }); }} className={`flex items-center gap-1.5 text-[10px] px-2 py-1 rounded ${layer.visible !== false ? 'text-[#8b949e] hover:text-[#e6edf3] bg-[#30363d]/30' : 'text-[#484f58] bg-[#21262d]'}`}>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">{layer.visible !== false ? <><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></> : <><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></>}</svg>
                  {layer.visible !== false ? 'Visible' : 'Oculto'}</button>
              </div>
              <div className="flex gap-2 mt-2 pt-2 border-t border-[#30363d]/50">
                <button onClick={() => { onRemoveLayer(layer.id); setActiveLayerId(null); }} className="text-[10px] text-[#f85149] hover:bg-[#f85149]/10 rounded px-2 py-1 flex items-center gap-1"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg> Eliminar</button>
              </div>
            </div>
          </div>);
        })()}
        {entities.map(e => (
          <EntityCard key={e.id} ref={el => entityRefs.current[e.id] = el}
            entity={e} position={positions[e.id] || { x: 0, y: 0 }} selected={selectedId === e.id}
            onSelect={() => onRelationClick(e.id)} onDragStart={handleMouseDown} onDelete={onDeleteEntity} onAddColumn={onAddColumn}
            activeRel={activeRel} hoveredRel={hoveredRel} relInfo={relInfo} pulseRel={pulseRel}
            relationMode={relationMode} isRelSrc={relationSource === e.id} isRelTgt={false}
            categories={entityCategories[e.id]} />
        ))}
      </div>
      {entities.length === 0 && (
        <div className="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div className="text-center opacity-60">
            <div className="bg-[#1f6feb]/10 rounded-2xl p-4 w-fit mx-auto mb-5">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#58a6ff" strokeWidth="1.2">
                <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><line x1="10" y1="6.5" x2="14" y2="6.5"/><line x1="6.5" y1="10" x2="6.5" y2="14"/><line x1="17.5" y1="10" x2="17.5" y2="14"/><line x1="10" y1="17.5" x2="14" y2="17.5"/></svg>
            </div>
            <h2 className="text-xl font-bold text-[#c9d1d9] mb-2">Diagram Creator</h2>
            <p className="text-sm text-[#8b949e] max-w-xs mx-auto leading-relaxed">Modela tus bases de datos visualmente.<br/>Haz clic en \"Entidad\" para comenzar.</p>
          </div>
        </div>
      )}
      {entities.length > 0 && (
        <div className="absolute bottom-4 right-4 flex items-center gap-1.5 bg-[#21262d]/90 backdrop-blur-sm border border-[#30363d]/60 rounded-xl p-2 shadow-lg z-20">
          <button onClick={onToggleMultiDrag}
            className={`rounded-lg w-9 h-9 flex items-center justify-center ${multiDragMode ? 'bg-[#1f6feb]/20 text-[#58a6ff]' : 'text-[#8b949e] bg-[#30363d]/50'}`}
            title={multiDragMode ? 'Seleccionar área activado' : 'Seleccionar área'}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" strokeDasharray="4 2" /></svg>
          </button>
          {selectedEntities && Object.keys(selectedEntities).length > 0 && (
            <button onClick={() => onSelectEntities([])} className="rounded-lg w-9 h-9 flex items-center justify-center text-[#f85149] bg-[#f85149]/10 hover:bg-[#f85149]/20" title="Deseleccionar todo">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          )}
          <button onClick={fitToScreen} className="text-[#8b949e] bg-[#30363d]/50 rounded-lg w-9 h-9 flex items-center justify-center" title="Ajustar">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          </button>
          <button onClick={() => onSetZoom(z => Math.max(0.25, z - 0.1))} className="text-[#8b949e] bg-[#30363d]/50 rounded-lg w-9 h-9 flex items-center justify-center text-lg font-bold">-</button>
          <span className="text-[12px] text-[#8b949e] w-12 text-center font-mono">{Math.round(zoom * 100)}%</span>
          <button onClick={() => onSetZoom(z => Math.min(3, z + 0.1))} className="text-[#8b949e] bg-[#30363d]/50 rounded-lg w-9 h-9 flex items-center justify-center text-lg font-bold">+</button>
        </div>
      )}
    </div>
  );
}

function App() {
  const [entities, setEntities] = useState([]);
  const [selectedId, setSelectedId] = useState(null);
  const [relations, setRelations] = useState([]);
  const [positions, setPositions] = useState({});
  const [zoom, setZoom] = useState(1);
  const [pan, setPan] = useState({ x: 0, y: 0 });
  const [relationMode, setRelationMode] = useState(false);
  const [relationSource, setRelationSource] = useState(null);
  const [showRelations, setShowRelations] = useState(false);
  const [activeRel, setActiveRel] = useState(null);
  const [linePaths, setLinePaths] = useState({});
  const [linePathHistory, setLinePathHistory] = useState({});
  const [selectedEntities, setSelectedEntities] = useState({});
  const [multiDragMode, setMultiDragMode] = useState(false);
  const [layers, setLayers] = useState([]);
  const [showLayers, setShowLayers] = useState(false);
  const [categories, setCategories] = useState([]);
  const [entityCategory, setEntityCategory] = useState({});
  const [showCategories, setShowCategories] = useState(false);
  const [showSortPanel, setShowSortPanel] = useState(false);
  const [sortFitKey, setSortFitKey] = useState(0);
  const [showLeft, setShowLeft] = useState(true);
  const fileInputRef = useRef(null);
  const entityColors = ['#6366f1','#ec4899','#22c55e','#f59e0b','#06b6d4','#8b5cf6','#f97316','#84cc16'];

  const addEntity = useCallback(() => {
    const id = uid();
    const idx = entities.length;
    setEntities(prev => [...prev, { id, name: `Entidad_${idx + 1}`, columns: [], color: entityColors[idx % entityColors.length] }]);
    setPositions(prev => ({ ...prev, [id]: { x: 120 + Math.random() * 200, y: 80 + Math.random() * 150 } }));
    setSelectedId(id);
  }, [entities.length]);

  const deleteEntity = useCallback((id) => {
    setEntities(prev => prev.filter(e => e.id !== id));
    setPositions(prev => { const p = { ...prev }; delete p[id]; return p; });
    setRelations(prev => prev.filter(r => r.sourceId !== id && r.targetId !== id));
    setSelectedId(prev => prev === id ? null : prev);
    setLinePaths(prev => { const np = { ...prev }; for (const k of Object.keys(np)) { const rel = relations.find(r => r.id === k); if (rel && (rel.sourceId === id || rel.targetId === id)) delete np[k]; } return np; });
  }, [relations]);

  const addColumn = useCallback((eid) => {
    setEntities(prev => prev.map(e => e.id === eid ? { ...e, columns: [...e.columns, { id: uid(), name: '', type: 'VARCHAR', length: 255, values: '', pk: false, nn: false, uq: false, ai: false, fk: false, refTable: '', refColumn: '' }] } : e));
  }, []);

  const updateColumn = useCallback((eid, colId, upd) => {
    setEntities(prev => prev.map(e => e.id === eid ? { ...e, columns: e.columns.map(c => c.id === colId ? upd : c) } : e));
  }, []);

  const deleteColumn = useCallback((eid, colId) => {
    setEntities(prev => prev.map(e => e.id === eid ? { ...e, columns: e.columns.filter(c => c.id !== colId) } : e));
  }, []);

  const updateEntityName = useCallback((id, name) => setEntities(prev => prev.map(e => e.id === id ? { ...e, name } : e)), []);
  const updateEntityColor = useCallback((id, color) => setEntities(prev => prev.map(e => e.id === id ? { ...e, color } : e)), []);

  const selEntity = useMemo(() => entities.find(e => e.id === selectedId) || null, [entities, selectedId]);

  const handleRelationClick = useCallback((entityId) => {
    if (!relationMode) return;
    if (!relationSource) { setRelationSource(entityId); return; }
    if (relationSource === entityId) { setRelationSource(null); return; }
    const exists = relations.some(r => r.sourceId === relationSource && r.targetId === entityId);
    if (!exists) {
      const id = uid();
      setRelations(prev => [...prev, { id, sourceId: relationSource, targetId: entityId, cardinality: 'M:1' }]);
      setActiveRel(id);
    }
    setRelationSource(null);
    setRelationMode(false);
  }, [relationMode, relationSource, relations]);

  useEffect(() => { if (!relationMode) setRelationSource(null); }, [relationMode]);

  const handlePositionChange = useCallback((id, x, y) => setPositions(prev => ({ ...prev, [id]: { x, y } })), []);

  const handleLinePathChange = useCallback((key, pts) => setLinePaths(prev => ({ ...prev, [key]: pts })), []);

  const handleResetLinePath = useCallback((key) => {
    setLinePaths(prev => { const n = { ...prev }; delete n[key]; return n; });
  }, []);

  const handleSaveLinePathState = useCallback((key) => {
    setLinePathHistory(prev => {
      const cur = linePaths[key];
      if (!cur) return prev;
      const h = prev[key] || [];
      return { ...prev, [key]: [...h.slice(-20), cur.map(p => ({ ...p }))] };
    });
  }, [linePaths]);

  const handleUndoLinePath = useCallback((key) => {
    setLinePathHistory(prev => {
      const h = prev[key];
      if (!h || h.length === 0) return prev;
      const restored = h[h.length - 1];
      const nh = h.slice(0, -1);
      setLinePaths(p => ({ ...p, [key]: restored }));
      return { ...prev, [key]: nh.length > 0 ? nh : undefined };
    });
  }, []);

  const updateRelation = useCallback((id, upd) => {
    setRelations(prev => prev.map(r => r.id === id ? { ...r, ...upd } : r));
  }, []);

  const deleteRelation = useCallback((id) => {
    setRelations(prev => prev.filter(r => r.id !== id));
    setActiveRel(prev => prev === id ? null : prev);
    setLinePaths(prev => { const n = { ...prev }; delete n[id]; return n; });
  }, []);

  const handleSelectEntities = useCallback((ids) => {
    setSelectedEntities(prev => {
      const next = {};
      for (const id of ids) next[id] = true;
      return next;
    });
  }, []);

  const addLayer = useCallback(() => {
    const colors = ['#6366f1','#ec4899','#22c55e','#f59e0b','#06b6d4','#8b5cf6','#f97316','#84cc16'];
    setLayers(prev => { const idx = prev.length; const offset = idx * 30; return [...prev, { id: uid(), name: `Capa ${idx + 1}`, color: colors[idx % colors.length], visible: true, x: 120 + offset, y: 80 + offset, w: 350, h: 250 }]; });
  }, []);

  const removeLayer = useCallback((id) => setLayers(prev => prev.filter(l => l.id !== id)), []);
  const updateLayer = useCallback((id, updates) => setLayers(prev => prev.map(l => l.id === id ? { ...l, ...updates } : l)), []);

  const addCategory = useCallback(() => {
    const catColors = ['#d29922','#58a6ff','#3fb950','#f85149','#bc8cff','#f0883e','#79c0ff','#56d364'];
    setCategories(prev => [...prev, { id: uid(), name: `Categoría ${prev.length + 1}`, color: catColors[prev.length % catColors.length] }]);
  }, []);

  const removeCategory = useCallback((id) => {
    setCategories(prev => prev.filter(c => c.id !== id));
    setEntityCategory(prev => { const p = { ...prev }; for (const k of Object.keys(p)) { if (p[k] === id) delete p[k]; } return p; });
  }, []);

  const updateCategory = useCallback((id, updates) => setCategories(prev => prev.map(c => c.id === id ? { ...c, ...updates } : c)), []);

  const setEntityCategoryId = useCallback((entityId, categoryId) => {
    setEntityCategory(prev => {
      if (!categoryId) { const p = { ...prev }; delete p[entityId]; return p; }
      return { ...prev, [entityId]: categoryId };
    });
  }, []);

  const handleSort = useCallback((sortId) => {
    const currentEntities = entities;
    if (currentEntities.length === 0) return;
    const tables = convertEntitiesToTables(currentEntities, relations);
    let newPos;
    switch (sortId) {
      case 'name': newPos = sortByName(tables); break;
      case 'nameDesc': newPos = sortByNameDesc(tables); break;
      case 'columnsAsc': newPos = sortByColumns(tables, true); break;
      case 'columnsDesc': newPos = sortByColumns(tables, false); break;
      case 'relationships': newPos = arrangeTables(tables, positions); break;
      case 'category': newPos = sortByCategory(tables, entityCategory, categories); break;
      case 'color': newPos = sortByColor(tables); break;
      case 'grid3': newPos = sortGrid(tables, 3); break;
      case 'grid4': newPos = sortGrid(tables, 4); break;
      case 'grid5': newPos = sortGrid(tables, 5); break;
      default: return;
    }
    setPositions(newPos);
    setLinePaths({});
    setSortFitKey(k => k + 1);
  }, [entities, relations, positions, entityCategory, categories]);

  const handleExportPNG = useCallback(() => exportPNG(`diagrama-${Date.now()}.png`), []);
  const handleExportPDF = useCallback(() => exportPDF(`diagrama-${Date.now()}.pdf`), []);

  const handleExportJSON = useCallback(() => {
    const data = { entities, relations, positions, zoom, pan, layers, categories, entityCategory, linePaths };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `diagrama-${Date.now()}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(a.href);
  }, [entities, relations, positions, zoom, pan, layers, categories, entityCategory, linePaths]);

  const handleImportJSON = useCallback((e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function (ev) {
      try {
        const data = JSON.parse(ev.target.result);
        if (data.entities) setEntities(data.entities);
        if (data.relations) setRelations(data.relations);
        if (data.positions) setPositions(data.positions);
        if (data.zoom !== undefined) setZoom(data.zoom);
        if (data.pan) setPan(data.pan);
        if (data.layers) setLayers(data.layers);
        if (data.categories) setCategories(data.categories);
        if (data.entityCategory) setEntityCategory(data.entityCategory);
        if (data.linePaths) setLinePaths(data.linePaths);
      } catch (err) { console.error('Error importing JSON:', err); }
    };
    reader.readAsText(file);
    e.target.value = '';
  }, []);

  const fitToScreen = useCallback(() => {
    const container = document.querySelector('.diagram-container');
    if (!container || entities.length === 0) return;
    const vals = Object.values(positions).filter(Boolean);
    if (vals.length === 0) return;
    const minX = Math.min(...vals.map(p => p.x)), minY = Math.min(...vals.map(p => p.y));
    const maxX = Math.max(...vals.map(p => p.x + 280)), maxY = Math.max(...vals.map(p => { const e = entities.find(ent => positions[ent.id] === p); return p.y + (e ? 40 + e.columns.length * 34 + 44 : 300); }));
    const cw = container.clientWidth, ch = container.clientHeight;
    const scale = Math.min(cw / (maxX - minX + 300), ch / (maxY - minY + 200), 1.5);
    setZoom(Math.max(0.25, Math.min(3, scale)));
    setPan({ x: (cw - (maxX - minX) * scale) / 2 - minX * scale, y: (ch - (maxY - minY) * scale) / 2 - minY * scale });
  }, [entities, positions]);

  const firstEntityCount = useRef(0);
  useEffect(() => {
