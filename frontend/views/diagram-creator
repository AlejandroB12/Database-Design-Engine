function Diagram({ entities, relations, positions, zoom, pan, activeRel, setActiveRel, relationMode, relationSource, onRelationClick, onDragStart, onDeleteEntity, onAddColumn, linePaths, onUpdateLinePath, onResetLinePath, onSaveLinePathState, onUndoLinePath, onPositionsChange, onSetZoom, onSetPan, selectedId, onSetSelected, selectedEntities, onSelectEntities, multiDragMode, onToggleMultiDrag, layers, onUpdateLayer, onRemoveLayer, entityCategory, categories, fitKey }) {
  const containerRef = useRef(null);
  const dragRef = useRef(null);
  const entityRefs = useRef({});
  const [entityDims, setEntityDims] = useState({});
  const [isPanning, setIsPanning] = useState(false);
  const panDragRef = useRef(null);
  const waypointDragRef = useRef(null);
  const entitiesRef = useRef(entities); entitiesRef.current = entities;
  const positionsRef = useRef(positions); positionsRef.current = positions;
  const entityDimsRef = useRef(entityDims); entityDimsRef.current = entityDims;
  const selectedEntitiesRef = useRef(selectedEntities); selectedEntitiesRef.current = selectedEntities;
  const rafRef = useRef(null);
  const pendingMouseEvent = useRef(null);
  const zoomRef = useRef(zoom); zoomRef.current = zoom;
  const panRef = useRef(pan); panRef.current = pan;
  const [hoveredRel, setHoveredRel] = useState(null);
  const [selRect, setSelRect] = useState(null);
  const selRectRef = useRef(null);
  const [activeLayerId, setActiveLayerId] = useState(null);
  const layerDragRef = useRef(null);
  const layerResizeRef = useRef(null);
  const pulseTimeoutRef = useRef(null);
  const [pulseRel, setPulseRel] = useState(null);
  const prevEntityCount = useRef(0);
  const prevFitKey = useRef(0);
  const routeCacheRef = useRef({});

  useEffect(() => { if (activeLayerId && !layers.find(l => l.id === activeLayerId)) setActiveLayerId(null); }, [layers, activeLayerId]);

  const fitToScreen = useCallback(() => {
    const container = containerRef.current;
    if (!container || entities.length === 0) return;
    const vals = Object.values(positions).filter(Boolean);
    if (vals.length === 0) return;
    const minX = Math.min(...vals.map(p => p.x)), minY = Math.min(...vals.map(p => p.y));
    const maxX = Math.max(...vals.map(p => p.x + 310)), maxY = Math.max(...vals.map(p => {
      const e = entities.find(ent => positions[ent.id] === p);
      return p.y + (e ? 40 + e.columns.length * 34 + 44 : 300);
    }));
    const cw = container.clientWidth, ch = container.clientHeight;
    const pad = 40;
    const scale = Math.min((cw - pad) / (maxX - minX + 280), (ch - pad) / (maxY - minY + 200), 1.5);
    const clamped = Math.max(0.25, Math.min(3, scale));
    onSetZoom(clamped);
    setPan({ x: (cw - (maxX - minX) * clamped) / 2 - minX * clamped, y: (ch - (maxY - minY) * clamped) / 2 - minY * clamped });
  }, [entities, positions, onSetZoom]);

  useEffect(() => {
    if (prevEntityCount.current === 0 && entities.length > 0) setTimeout(fitToScreen, 50);
    prevEntityCount.current = entities.length;
  }, [entities, fitToScreen]);

  useEffect(() => {
    if (prevFitKey.current !== fitKey && entities.length > 0) { Promise.resolve().then(fitToScreen); prevFitKey.current = fitKey; }
  }, [fitKey, entities, fitToScreen]);

  useEffect(() => {
    const dims = {};
    for (const e of entities) { const el = entityRefs.current[e.id]; if (el) { const r = el.getBoundingClientRect(); dims[e.id] = { w: r.width / zoom, h: r.height / zoom }; } }
    setEntityDims(dims);
  }, [entities, zoom]);

  const relInfo = useMemo(() => {
    const m = {};
    for (const rel of relations) {
      const src = entities.find(e => e.id === rel.sourceId);
      const tgt = entities.find(e => e.id === rel.targetId);
      let fkCol = null, refCol = null, fkEntityId = null, refEntityId = null;
      if (src && tgt) {
        const tgtFk = (tgt.columns || []).find(c => c.fk && c.refTable === src.name);
        const srcFk = (src.columns || []).find(c => c.fk && c.refTable === tgt.name);
        if (tgtFk) {
          fkCol = tgtFk; fkEntityId = rel.targetId;
          refCol = (src.columns || []).find(c => c.name === (tgtFk.refColumn || 'id')) || null; refEntityId = rel.sourceId;
        } else if (srcFk) {
          fkCol = srcFk; fkEntityId = rel.sourceId;
          refCol = (tgt.columns || []).find(c => c.name === (srcFk.refColumn || 'id')) || null; refEntityId = rel.targetId;
        }
      }
      m[rel.id] = { sourceId: rel.sourceId, targetId: rel.targetId, cardinality: rel.cardinality, fkCol: fkCol ? fkCol.name : null, refCol: refCol ? refCol.name : null, fkEntityId, refEntityId };
    }
    return m;
  }, [relations, entities]);

  const layerShapes = useMemo(() =>
    layers.map(layer => { const rect = layerRectPath(layer); return { ...layer, ...rect, visible: layer.visible !== false }; }),
  [layers]);

  const entityCategories = useMemo(() => {
    const m = {};
    for (const eid of Object.keys(entityCategory || {})) { const catId = entityCategory[eid]; const cat = categories.find(c => c.id === catId); if (cat) m[eid] = [{ name: cat.name, color: cat.color }]; }
    return m;
  }, [categories, entityCategory]);

  const svgLines = useMemo(() => {
    const lines = []; const rects = {};
    for (const e of entities) { const p = positions[e.id]; const d = entityDims[e.id]; if (p && d) rects[e.id] = { x: p.x, y: p.y, w: d.w, h: d.h }; }
    for (const rel of relations) {
      const srcRect = rects[rel.sourceId]; const tgtRect = rects[rel.targetId];
      if (!srcRect || !tgtRect) continue;
      const srcColIdx = 0; const tgtColIdx = 0;
      const obstacles = entities.filter(e2 => e2.id !== rel.sourceId && e2.id !== rel.targetId).map(e2 => rects[e2.id]).filter(Boolean);
      let points;
      if (linePaths && linePaths[rel.id]) { points = linePaths[rel.id]; }
      else {
        const cacheKey = `${rel.id}_${srcRect.x},${srcRect.y},${srcRect.w},${srcRect.h}_${tgtRect.x},${tgtRect.y},${tgtRect.w},${tgtRect.h}`;
        const cached = routeCacheRef.current[cacheKey];
        if (cached) points = cached;
        else { points = findRoute(srcRect, srcColIdx, tgtRect, tgtColIdx, obstacles); routeCacheRef.current[cacheKey] = points; if (Object.keys(routeCacheRef.current) > 200) routeCacheRef.current = {}; }
      }
      if (points) {
        const card = rel.cardinality || 'M:1';
        const sp = points.length >= 2 ? midpoint(points[0], points[1]) : points[0];
        const ep = points.length >= 2 ? midpoint(points[points.length - 2], points[points.length - 1]) : points[points.length - 1];
        const ri = relInfo[rel.id];
        const fkOnSource = ri && ri.fkEntityId === rel.sourceId;
        let sl, el, sm, em;
        if (card === '1:1') { sl='1'; el='1'; sm='one'; em='one'; }
        else if (card === 'M:M') { sl='N'; el='N'; sm='many'; em='many'; }
        else if (fkOnSource) { sl='N'; el='1'; sm='many'; em='one'; }
        else { sl='1'; el='N'; sm='one'; em='many'; }
        lines.push({ key: rel.id, points, startPos: sp, endPos: ep, startLabel: sl, endLabel: el, startMarker: sm, endMarker: em, cardinality: card });
      }
    }
    return lines;
  }, [entities, relations, positions, entityDims, linePaths]);

  const handleWheel = useCallback((e) => { e.preventDefault(); onSetZoom(z => Math.max(0.25, Math.min(3, z + (e.deltaY > 0 ? -0.1 : 0.1)))); }, [onSetZoom]);

  const handleMouseDown = useCallback((e, entityId) => {
    if (e.button !== 0) return; e.stopPropagation();
    if (relationMode) return;
    const pos = positions[entityId];
    if (!pos) return;
    const curSel = selectedEntitiesRef.current || {};
    const entitySelected = curSel[entityId];
    const multiCount = Object.keys(curSel).length;
    let dragInfo;
    if (multiDragMode) {
      const origins = {}; for (const e of entities) { const p = positions[e.id]; if (p) origins[e.id] = { x: p.x, y: p.y }; }
      dragInfo = { entityId, startX: e.clientX, startY: e.clientY, origins, moved: false };
    } else if (entitySelected && multiCount > 1) {
      const origins = {}; for (const id of Object.keys(curSel)) { const p = positions[id]; if (p) origins[id] = { x: p.x, y: p.y }; }
      dragInfo = { entityId, startX: e.clientX, startY: e.clientY, origins, moved: false };
    } else dragInfo = { entityId, startX: e.clientX, startY: e.clientY, origX: pos.x, origY: pos.y, moved: false };
    if (linePaths) {
      const dragIds = dragInfo.origins ? Object.keys(dragInfo.origins) : [entityId];
      const affected = {};
      for (const [key, pts] of Object.entries(linePaths)) {
        const rel = relations.find(r => r.id === key);
        if (!rel) continue;
        const indices = [];
        if (dragIds.includes(rel.sourceId)) indices.push(0);
        if (dragIds.includes(rel.targetId)) indices.push(pts.length - 1);
        if (indices.length > 0) affected[key] = { pts: pts.map(p => ({...p})), indices };
      }
      dragInfo.affectedLinePaths = affected;
    }
    dragRef.current = dragInfo;
    document.addEventListener('mousemove', handleMouseMove); document.addEventListener('mouseup', handleMouseUp);
  }, [positions, entities, relations, linePaths, relationMode, multiDragMode, handleMouseMove, handleMouseUp]);

  const handleWaypointMove = useCallback((e) => {
    const dr = waypointDragRef.current;
    if (!dr) return;
    const dx = (e.clientX - dr.startX) / zoomRef.current;
    const dy = (e.clientY - dr.startY) / zoomRef.current;
    const pi = dr.pointIndex;
    const orig = dr.origPoints;
    if (pi <= 0 || pi >= orig.length - 1) {
      let np = orig.map((p, i) => i === pi ? { x: p.x + dx, y: p.y + dy } : { ...p });
      const rel = relations.find(r => r.id === dr.relId);
      if (rel) np = snapEndpointsToEntity(np, rel.sourceId, rel.targetId, entitiesRef.current, positionsRef.current, entityDimsRef.current);
      onUpdateLinePath(dr.relId, np); return;
    }
    const eps = 0.5;
    const pH = Math.abs(orig[pi - 1].y - orig[pi].y) < eps;
    const nH = Math.abs(orig[pi].y - orig[pi + 1].y) < eps;
    const np = orig.map(p => ({ ...p }));
    np[pi].x = orig[pi].x + dx; np[pi].y = orig[pi].y + dy;
    if (pH && !nH) { np[pi - 1].x = orig[pi - 1].x; np[pi - 1].y = np[pi].y; np[pi + 1].x = np[pi].x; np[pi + 1].y = orig[pi + 1].y; }
    else if (!pH && nH) { np[pi - 1].x = np[pi].x; np[pi - 1].y = orig[pi - 1].y; np[pi + 1].x = orig[pi + 1].x; np[pi + 1].y = np[pi].y; }
    const rel = relations.find(r => r.id === dr.relId);
    const snapped = rel ? snapEndpointsToEntity(np, rel.sourceId, rel.targetId, entitiesRef.current, positionsRef.current, entityDimsRef.current) : np;
    onUpdateLinePath(dr.relId, snapped);
  }, [onUpdateLinePath, relations]);

  const handleLineMouseDown = useCallback((e, relId, points) => {
    e.stopPropagation();
    if (e.button !== 0) return;
    if (onSaveLinePathState) onSaveLinePathState(relId);
    const rect = containerRef.current?.getBoundingClientRect();
    if (!rect) return;
    const mx = (e.clientX - rect.left - pan.x) / zoom;
    const my = (e.clientY - rect.top - pan.y) / zoom;
    let bestSeg = 0, bestDist = Infinity;
    for (let i = 0; i < points.length - 1; i++) {
      const ax = points[i].x, ay = points[i].y, bx = points[i + 1].x, by = points[i + 1].y;
      const dx = bx - ax, dy = by - ay, len = Math.sqrt(dx * dx + dy * dy);
      if (len < 0.001) continue;
      const t = Math.max(0, Math.min(1, ((mx - ax) * dx + (my - ay) * dy) / (len * len)));
      const cx = ax + t * dx, cy = ay + t * dy, dist = Math.hypot(mx - cx, my - cy);
      if (dist < bestDist) { bestDist = dist; bestSeg = i; }
    }
    const newPts = [...points];
    newPts.splice(bestSeg + 1, 0, { x: mx, y: my });
    onUpdateLinePath(relId, newPts);
    setActiveRel(relId);
    waypointDragRef.current = { relId, pointIndex: bestSeg + 1, startX: e.clientX, startY: e.clientY, origPoints: newPts.map(p => ({ ...p })) };
    document.addEventListener('mousemove', handleMouseMove);
    document.addEventListener('mouseup', handleMouseUp);
  }, [pan, zoom, onUpdateLinePath, onSaveLinePathState, setActiveRel, handleMouseMove, handleMouseUp]);

  const handleWaypointDblClick = useCallback((e, relId, pi, pts) => {
    e.preventDefault(); e.stopPropagation();
    if (pts.length <= 2) return;
    if (onSaveLinePathState) onSaveLinePathState(relId);
    const np = pts.filter((_, i) => i !== pi);
    if (np.length < 2) { onResetLinePath(relId); return; }
    onUpdateLinePath(relId, np);
  }, [onUpdateLinePath, onResetLinePath, onSaveLinePathState]);

  const processMouseEvent = useCallback((e) => {
    if (dragRef.current) {
      const dr = dragRef.current; const dx = (e.clientX - dr.startX) / zoomRef.current; const dy = (e.clientY - dr.startY) / zoomRef.current;
      if (Math.abs(e.clientX - dr.startX) > 3 || Math.abs(e.clientY - dr.startY) > 3) dr.moved = true;
      if (dr.origins) { for (const id of Object.keys(dr.origins)) onPositionsChange(id, dr.origins[id].x + dx, dr.origins[id].y + dy); }
      else onPositionsChange(dr.entityId, dr.origX + dx, dr.origY + dy);
      if (dr.affectedLinePaths) {
        for (const [key, { pts: origPts, indices }] of Object.entries(dr.affectedLinePaths)) {
          const np = origPts.map((p, i) => indices.includes(i) ? { x: p.x + dx, y: p.y + dy } : { ...p });
          for (const idx of indices) { const eps = 0.5;
            if (idx === 0 && np.length >= 2) { if (Math.abs(origPts[0].y - origPts[1].y) < eps) np[1].y = np[0].y; else np[1].x = np[0].x; }
            if (idx === np.length - 1 && np.length >= 2) { const last = np.length - 1; if (Math.abs(origPts[last - 1].y - origPts[last].y) < eps) np[last - 1].y = np[last].y; else np[last - 1].x = np[last].x; }
          }
          const rel = relations.find(r => r.id === key);
          const snapped = rel ? snapEndpointsToEntity(np, rel.sourceId, rel.targetId, entitiesRef.current, positionsRef.current, entityDimsRef.current) : np;
          onUpdateLinePath(key, snapped);
        }
      }
      return;
    }
    if (panDragRef.current) { onSetPan({ x: panDragRef.current.origPanX + (e.clientX - panDragRef.current.startX), y: panDragRef.current.origPanY + (e.clientY - panDragRef.current.startY) }); }
    if (layerResizeRef.current) {
      const dr = layerResizeRef.current; const dx = (e.clientX - dr.startX) / zoomRef.current; const dy = (e.clientY - dr.startY) / zoomRef.current;
      const upd = {}; const minW = 100, minH = 60;
      if (dr.sx === 1) upd.w = Math.max(minW, dr.origW + dx); else { upd.x = dr.origX + dx; upd.w = Math.max(minW, dr.origW - dx); }
      if (dr.sy === 1) upd.h = Math.max(minH, dr.origH + dy); else { upd.y = dr.origY + dy; upd.h = Math.max(minH, dr.origH - dy); }
      onUpdateLayer(dr.layerId, upd); if (Math.abs(e.clientX - dr.startX) > 3 || Math.abs(e.clientY - dr.startY) > 3) dr.moved = true; return;
    }
    if (layerDragRef.current) {
      const dr = layerDragRef.current; const dx = (e.clientX - dr.startX) / zoomRef.current; const dy = (e.clientY - dr.startY) / zoomRef.current;
      if (Math.abs(e.clientX - dr.startX) > 3 || Math.abs(e.clientY - dr.startY) > 3) dr.moved = true;
      onUpdateLayer(dr.layerId, { x: dr.origX + dx, y: dr.origY + dy }); return;
    }
