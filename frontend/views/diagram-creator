                    const src = entities.find(e => e.id === rel.sourceId);
                    const tgt = entities.find(e => e.id === rel.targetId);
                    const cardLabels = { '1:1': 'Uno a Uno', '1:M': 'Uno a Muchos', 'M:1': 'Muchos a Uno', 'M:M': 'Muchos a Muchos' };
                    return (
                      <div key={rel.id} onClick={() => setActiveRel(rel.id)}
                        className={`rounded-lg border cursor-pointer p-3 transition-all ${activeRel === rel.id ? 'border-[#58a6ff]/50 bg-[#1f6feb]/10' : 'border-[#30363d] bg-[#0d1117] hover:border-[#484f58]'}`}>
                        <div className="flex items-center gap-1.5 mb-1.5">
                          <span className="text-[12px] font-semibold text-[#c9d1d9] truncate">{src?.name || '?'}</span>
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#6e7681" strokeWidth="2" className="shrink-0"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                          <span className="text-[12px] font-semibold text-[#c9d1d9] truncate">{tgt?.name || '?'}</span>
                        </div>
                        <div className="flex items-center gap-1">
                          <span className="text-[10px] font-mono font-bold text-[#58a6ff] bg-[#1f6feb]/15 rounded px-1.5 py-0.5">{rel.cardinality || 'M:1'}</span>
                          <span className="text-[10px] text-[#6e7681] ml-1">{cardLabels[rel.cardinality] || ''}</span>
                        </div>
                      </div>
                    );
                  })
                )}
              </div>
            </div>
          )}
          {Object.keys(selectedEntities).length > 1 && (
            <div className="absolute bottom-16 left-1/2 -translate-x-1/2 bg-[#21262d]/95 border border-[#30363d]/50 rounded-lg px-4 py-2 shadow-lg z-20">
              <p className="text-[12px] text-[#8b949e] text-center">{Object.keys(selectedEntities).length} entidades seleccionadas</p>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App />);
  </script>
</body>
</html>
