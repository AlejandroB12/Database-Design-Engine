    document.removeEventListener('mousemove', handleMouseMove); document.removeEventListener('mouseup', handleMouseUp);
  }, [onSetSelected, onSelectEntities, relationMode, handleMouseMove, handleMouseUp]);

  useEffect(() => { return () => { if (rafRef.current) cancelAnimationFrame(rafRef.current); document.removeEventListener('mousemove', handleMouseMove); document.removeEventListener('mouseup', handleMouseUp); }; }, [handleMouseMove, handleMouseUp]);

  const handleWpMouseDown = useCallback((e, relId, pi) => {
    e.stopPropagation();
    if (onSaveLinePathState) onSaveLinePathState(relId);
    const src = (linePaths && linePaths[relId]) || svgLines.find(l => l.key === relId)?.points;
    if (!src) return;
    waypointDragRef.current = { relId, pointIndex: pi, startX: e.clientX, startY: e.clientY, origPoints: src.map(p => ({ ...p })) };
    document.addEventListener('mousemove', handleMouseMove);
    document.addEventListener('mouseup', handleMouseUp);
  }, [linePaths, svgLines, handleMouseMove, handleMouseUp, onSaveLinePathState]);

  const handleLayerMouseDown = useCallback((e, layerId) => {
    if (e.button !== 0) return; e.stopPropagation(); const layer = layers.find(l => l.id === layerId); if (!layer) return;
    setActiveLayerId(layerId);
    layerDragRef.current = { layerId, startX: e.clientX, startY: e.clientY, origX: layer.x, origY: layer.y, moved: false };
    document.addEventListener('mousemove', handleMouseMove); document.addEventListener('mouseup', handleMouseUp);
  }, [layers, handleMouseMove, handleMouseUp]);

  const handleLayerResizeDown = useCallback((e, layerId, sx, sy) => {
    if (e.button !== 0) return; e.stopPropagation(); const layer = layers.find(l => l.id === layerId); if (!layer) return;
    setActiveLayerId(layerId);
    layerResizeRef.current = { layerId, startX: e.clientX, startY: e.clientY, sx, sy, origX: layer.x, origY: layer.y, origW: layer.w, origH: layer.h };
    document.addEventListener('mousemove', handleMouseMove); document.addEventListener('mouseup', handleMouseUp);
  }, [layers, handleMouseMove, handleMouseUp]);

  const handleCanvasMouseDown = useCallback((e) => {
    if (e.button !== 0) return;
    if (e.target.closest('.table-card') || e.target.closest('button') || e.target.closest('select') || e.target.closest('input') || e.target.closest('textarea')) return;
    if (e.target.closest('.layer-hit')) return; if (e.target.closest('.layer-handle')) return;
    setActiveLayerId(null); setActiveRel(null);
    if (relationMode) { onRelationClick(null); return; }
    if (multiDragMode) {
      const rect = containerRef.current?.getBoundingClientRect();
      if (!rect) return;
      const mx = (e.clientX - rect.left - pan.x) / zoom;
      const my = (e.clientY - rect.top - pan.y) / zoom;
      selRectRef.current = { startX: mx, startY: my, endX: mx, endY: my };
      setSelRect({ startX: mx, startY: my, endX: mx, endY: my });
      document.addEventListener('mousemove', handleMouseMove); document.addEventListener('mouseup', handleMouseUp);
      return;
    }
    onSetSelected(null);
    panDragRef.current = { startX: e.clientX, startY: e.clientY, origPanX: pan.x, origPanY: pan.y };
    setIsPanning(true); document.addEventListener('mousemove', handleMouseMove); document.addEventListener('mouseup', handleMouseUp);
  }, [pan.x, pan.y, relationMode, multiDragMode, zoom, onRelationClick, onSetSelected, handleMouseMove, handleMouseUp]);

  const canvasBounds = useMemo(() => {
    const container = containerRef.current;
    const cw = container?.clientWidth || 1200;
    const ch = container?.clientHeight || 800;
    const PAD = 1200;
    let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
    for (const e of entities) { const p = positions[e.id]; if (!p) continue; const h = 40 + e.columns.length * 34 + 44; minX = Math.min(minX, p.x); minY = Math.min(minY, p.y); maxX = Math.max(maxX, p.x + 310); maxY = Math.max(maxY, p.y + h); }
    for (const layer of layers) { if (layer.visible === false) continue; minX = Math.min(minX, layer.x); minY = Math.min(minY, layer.y); maxX = Math.max(maxX, layer.x + layer.w); maxY = Math.max(maxY, layer.y + layer.h); }
    const w = isFinite(maxX) ? maxX - minX + PAD * 2 : cw;
    const h = isFinite(maxY) ? maxY - minY + PAD * 2 : ch;
    return { width: Math.max(w, cw), height: Math.max(h, ch) };
  }, [entities, positions, layers]);

  return (
    <div ref={containerRef}
      className={`diagram-container absolute inset-0 overflow-hidden diagram-pattern ${isPanning ? 'panning' : ''}`}
      style={{ cursor: relationMode ? 'crosshair' : undefined }}
      onWheel={handleWheel} onMouseDown={handleCanvasMouseDown}>
      <div className="diagram-canvas absolute" style={{ transform: `translate(${pan.x}px, ${pan.y}px) scale(${zoom})`, transformOrigin: '0 0', width: canvasBounds.width, height: canvasBounds.height }}>
        <svg className="absolute inset-0 w-full h-full diagram-svg" style={{ overflow: 'visible', zIndex: 0 }}>
          <defs>
            <marker id="one-marker" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="10" markerHeight="10" orient="auto"><line x1="6" y1="1" x2="6" y2="11" stroke="#ffffff" strokeWidth="2" opacity="0.85" /></marker>
            <marker id="one-marker-hl" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="10" markerHeight="10" orient="auto"><line x1="6" y1="1" x2="6" y2="11" stroke="#ffffff" strokeWidth="2.5" /></marker>
            <marker id="one-marker-end" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="10" markerHeight="10" orient="auto"><line x1="6" y1="1" x2="6" y2="11" stroke="#ffffff" strokeWidth="2" opacity="0.85" /></marker>
            <marker id="one-marker-end-hl" viewBox="0 0 12 12" refX="6" refY="6" markerWidth="10" markerHeight="10" orient="auto"><line x1="6" y1="1" x2="6" y2="11" stroke="#ffffff" strokeWidth="2.5" /></marker>
            <marker id="many-marker" viewBox="0 0 16 14" refX="0" refY="7" markerWidth="14" markerHeight="12" orient="auto"><line x1="0" y1="2" x2="5" y2="7" stroke="#ffffff" strokeWidth="1.5" opacity="0.85" /><line x1="0" y1="12" x2="5" y2="7" stroke="#ffffff" strokeWidth="1.5" opacity="0.85" /><line x1="0" y1="7" x2="5" y2="7" stroke="#ffffff" strokeWidth="2" opacity="0.85" /></marker>
            <marker id="many-marker-hl" viewBox="0 0 16 14" refX="0" refY="7" markerWidth="14" markerHeight="12" orient="auto"><line x1="0" y1="2" x2="5" y2="7" stroke="#ffffff" strokeWidth="2" /><line x1="0" y1="12" x2="5" y2="7" stroke="#ffffff" strokeWidth="2" /><line x1="0" y1="7" x2="5" y2="7" stroke="#ffffff" strokeWidth="2.5" /></marker>
            <marker id="many-marker-end" viewBox="0 0 16 14" refX="0" refY="7" markerWidth="14" markerHeight="12" orient="auto"><line x1="5" y1="2" x2="0" y2="7" stroke="#ffffff" strokeWidth="1.5" opacity="0.85" /><line x1="5" y1="12" x2="0" y2="7" stroke="#ffffff" strokeWidth="1.5" opacity="0.85" /><line x1="5" y1="7" x2="0" y2="7" stroke="#ffffff" strokeWidth="2" opacity="0.85" /></marker>
            <marker id="many-marker-end-hl" viewBox="0 0 16 14" refX="0" refY="7" markerWidth="14" markerHeight="12" orient="auto"><line x1="5" y1="2" x2="0" y2="7" stroke="#ffffff" strokeWidth="2" /><line x1="5" y1="12" x2="0" y2="7" stroke="#ffffff" strokeWidth="2" /><line x1="5" y1="7" x2="0" y2="7" stroke="#ffffff" strokeWidth="2.5" /></marker>
            <filter id="glow"><feGaussianBlur stdDeviation="2.5" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
            <filter id="layer-glow"><feGaussianBlur stdDeviation="20" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
            <filter id="layer-glow-inner"><feGaussianBlur stdDeviation="4" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
          </defs>
          {entities.length > 0 && <rect x="0" y="0" width={canvasBounds.width} height={canvasBounds.height} fill="transparent" stroke="rgba(139,148,158,0.5)" strokeWidth="2" strokeDasharray="10 6" rx="6" ry="6" style={{ pointerEvents: 'none' }} />}
          {entities.length > 0 && (() => { const c = '#8b949e', o = 0.4, s = 24, g = 4, w = canvasBounds.width, h = canvasBounds.height; return (<g opacity={o} stroke={c} strokeWidth="2" fill="none" style={{ pointerEvents: 'none' }}><path d={`M${g},${g + s} L${g},${g} L${g + s},${g}`} /><path d={`M${w - g - s},${g} L${w - g},${g} L${w - g},${g + s}`} /><path d={`M${g},${h - g - s} L${g},${h - g} L${g + s},${h - g}`} /><path d={`M${w - g - s},${h - g} L${w - g},${h - g} L${w - g},${h - g - s}`} /></g>); })()}
          {selRect && (() => { const x = Math.min(selRect.startX, selRect.endX); const y = Math.min(selRect.startY, selRect.endY); const w = Math.abs(selRect.endX - selRect.startX); const h = Math.abs(selRect.endY - selRect.startY); return <rect x={x} y={y} width={w} height={h} fill="rgba(88, 166, 255, 0.08)" stroke="rgba(88, 166, 255, 0.6)" strokeWidth="1.5" strokeDasharray="5 3" rx="3" ry="3" style={{ pointerEvents: 'none' }} />; })()}
          {layerShapes.filter(ls => ls.visible !== false).map(ls => (
            <g key={ls.id}>
              <path d={ls.path} fill={ls.color} fillOpacity="0.04" filter="url(#layer-glow)" style={{ pointerEvents: 'none' }} />
              <path d={ls.path} fill={ls.color} fillOpacity="0.08" style={{ pointerEvents: 'none' }} />
              <path d={ls.path} fill="none" stroke={ls.color} strokeWidth="0.5" strokeOpacity="0.12" transform="translate(0, 1)" style={{ pointerEvents: 'none' }} />
              <path d={ls.path} fill="none" stroke={ls.color} strokeWidth="1" strokeOpacity={activeLayerId === ls.id ? '0.6' : '0.3'} strokeDasharray={activeLayerId === ls.id ? 'none' : '6 4'} style={{ pointerEvents: 'none' }} />
              <path d={ls.path} fill="transparent" stroke="transparent" strokeWidth="8" className="layer-hit" style={{ pointerEvents: 'all', cursor: 'grab' }} onMouseDown={e => handleLayerMouseDown(e, ls.id)} />
              {activeLayerId === ls.id && <><path d={ls.path} fill="none" stroke={ls.color} strokeWidth="2.5" strokeOpacity="0.6" filter="url(#layer-glow-inner)" style={{ pointerEvents: 'none' }} /><rect x={ls.x} y={ls.y} width={ls.w} height={ls.h} fill="none" stroke={ls.color} strokeWidth="1" strokeOpacity="0.15" rx="12" ry="12" style={{ pointerEvents: 'none' }} /></>}
              {activeLayerId === ls.id && [-1, 1].flatMap(sx => [-1, 1].map(sy => {
