  }, [processMouseEvent]);

  const handleMouseUp = useCallback((e) => {
    layerResizeRef.current = null; layerDragRef.current = null;
    if (waypointDragRef.current) { waypointDragRef.current = null; }
    if (selRectRef.current) {
      const r = selRectRef.current;
      const minX = Math.min(r.startX, r.endX), maxX = Math.max(r.startX, r.endX);
      const minY = Math.min(r.startY, r.endY), maxY = Math.max(r.startY, r.endY);
      selRectRef.current = null; setSelRect(null);
      const ids = [];
      if (maxX - minX > 5 || maxY - minY > 5) {
        for (const e of entitiesRef.current) { const p = positionsRef.current[e.id]; if (!p) continue; const h = 40 + e.columns.length * 34 + 44; if (p.x < maxX && p.x + 310 > minX && p.y < maxY && p.y + h > minY) ids.push(e.id); }
      }
      if (ids.length > 0 && onSelectEntities) onSelectEntities(ids);
    }
    if (dragRef.current) {
      if (!dragRef.current.moved && e.target.closest('.table-card')) { if (!relationMode) onSetSelected(dragRef.current.entityId); }
      dragRef.current = null;
    }
    if (panDragRef.current) { panDragRef.current = null; setIsPanning(false); }
    if (rafRef.current) { cancelAnimationFrame(rafRef.current); rafRef.current = null; }
