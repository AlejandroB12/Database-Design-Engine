  <style>
    body { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; background: #0d1117; }
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: #161b22; }
    ::-webkit-scrollbar-thumb { background: #30363d; border-radius: 3px; }
    .diagram-container { cursor: grab; }
    .diagram-container.panning { cursor: grabbing; }
    .diagram-container .table-card { cursor: default; }
    .diagram-pattern {
      background-color: #0d1117;
      background-image: url('/images/fondo.webp');
      background-size: cover;
      background-position: center;
      background-blend-mode: overlay;
    }
    .diagram-svg { pointer-events: none; }
    .diagram-canvas { transform-origin: 0 0; }
    .diagram-svg line { cursor: pointer; }
    .table-card.dragging { z-index: 100; box-shadow: 0 16px 48px rgba(0,0,0,0.6), 0 4px 12px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.08) !important; transform: translateY(-2px); }
    .table-card.relation-source { box-shadow: 0 0 0 2px #58a6ff, 0 0 20px rgba(88,166,255,0.3) !important; }
    .table-card.relation-target { box-shadow: 0 0 0 2px #3fb950, 0 0 20px rgba(63,185,80,0.3) !important; }
    button {
      position: relative;
      box-shadow: 0 2px 0 rgba(13,17,23,0.6), 0 4px 8px rgba(0,0,0,0.3);
      transition: all 0.12s cubic-bezier(0.4, 0, 0.2, 1);
      transform: translateY(0);
    }
    button:hover:not(:disabled) {
      box-shadow: 0 3px 0 rgba(13,17,23,0.6), 0 6px 14px rgba(0,0,0,0.45);
      transform: translateY(-1px);
    }
    button:active:not(:disabled) {
      box-shadow: 0 1px 0 rgba(13,17,23,0.6), 0 2px 4px rgba(0,0,0,0.25);
      transform: translateY(1px);
    }
    button:disabled { opacity: 0.5; cursor: not-allowed; }
    @keyframes col-pulse {
      0%, 100% { background-color: rgba(88, 166, 255, 0.06); border-left-color: rgba(88, 166, 255, 0.2); }
      25% { background-color: rgba(88, 166, 255, 0.3); border-left-color: rgba(88, 166, 255, 0.9); }
      50% { background-color: rgba(88, 166, 255, 0.2); border-left-color: rgba(88, 166, 255, 0.6); }
      75% { background-color: rgba(88, 166, 255, 0.3); border-left-color: rgba(88, 166, 255, 0.9); }
    }
    .col-pulse { animation: col-pulse 1.2s ease-in-out 2; }
    .sql-keyword { color: #ff7b72; font-weight: 600; }
    .sql-string { color: #a5d6ff; }
    .sql-number { color: #79c0ff; }
    .sql-comment { color: #8b949e; font-style: italic; }
    .sql-operator { color: #c9d1d9; }
    .sql-backtick { color: #7ee787; }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
const { useState, useCallback, useMemo, useRef, useEffect } = React;



function midpoint(p1, p2) { return { x: (p1.x + p2.x) / 2, y: (p1.y + p2.y) / 2 }; }

function closestOnRect(px, py, rx, ry, rw, rh) {
  const left = rx, right = rx + rw, top = ry, bottom = ry + rh;
  const cx = Math.max(left, Math.min(right, px));
  const cy = Math.max(top, Math.min(bottom, py));
  if (cx === px && cy === py) {
    const dl = px - left, dr = right - px, dt = py - top, db = bottom - py;
    const min = Math.min(dl, dr, dt, db);
    if (min === dl) return { x: left, y: cy };
    if (min === dr) return { x: right, y: cy };
    if (min === dt) return { x: cx, y: top };
    return { x: cx, y: bottom };
  }
  if (px < left) { if (py < top) return { x: left, y: top }; if (py > bottom) return { x: left, y: bottom }; return { x: left, y: py }; }
  if (px > right) { if (py < top) return { x: right, y: top }; if (py > bottom) return { x: right, y: bottom }; return { x: right, y: py }; }
  if (py < top) return { x: px, y: top };
  return { x: px, y: bottom };
}

function snapEndpointsToEntity(points, srcId, tgtId, entities, positions, dims) {
  if (points.length < 2) return points;
  const np = points.map(p => ({...p}));
  if (dims[srcId] && positions[srcId]) {
    const p = positions[srcId], d = dims[srcId];
    const ref = np.length >= 2 ? np[1] : np[0];
    const sn = closestOnRect(ref.x, ref.y, p.x, p.y, d.w, d.h);
    np[0] = sn;
    if (np.length >= 2) {
      if (Math.abs(sn.x - np[1].x) < Math.abs(sn.y - np[1].y)) np[1].x = sn.x; else np[1].y = sn.y;
    }
  }
  if (dims[tgtId] && positions[tgtId]) {
    const p = positions[tgtId], d = dims[tgtId];
    const li = np.length - 1;
    const ref = np.length >= 2 ? np[li - 1] : np[li];
    const sn = closestOnRect(ref.x, ref.y, p.x, p.y, d.w, d.h);
    np[li] = sn;
    if (np.length >= 2) {
      if (Math.abs(sn.x - np[li - 1].x) < Math.abs(sn.y - np[li - 1].y)) np[li - 1].x = sn.x; else np[li - 1].y = sn.y;
    }
  }
  return np;
}

function pathLength(points) {
  let len = 0;
  for (let i = 0; i < points.length - 1; i++) len += Math.abs(points[i].x - points[i+1].x) + Math.abs(points[i].y - points[i+1].y);
  return len;
}

function pathCrossesRect(points, rect) {
  for (let i = 0; i < points.length - 1; i++) {
    const p1 = points[i], p2 = points[i+1];
    if (p1.x === p2.x) {
      const minY = Math.min(p1.y, p2.y), maxY = Math.max(p1.y, p2.y);
      if (p1.x >= rect.x && p1.x <= rect.x + rect.w && maxY >= rect.y && minY <= rect.y + rect.h) return true;
    } else {
      const minX = Math.min(p1.x, p2.x), maxX = Math.max(p1.x, p2.x);
      if (p1.y >= rect.y && p1.y <= rect.y + rect.h && maxX >= rect.x && minX <= rect.x + rect.w) return true;
    }
  }
  return false;
}

function findRoute(srcRect, srcColIdx, tgtRect, tgtColIdx, obstacles) {
  const colH = 34, headerH = 40;
  const getColY = (rect, idx) => rect.y + headerH + (idx >= 0 ? idx * colH + colH / 2 : colH / 2);
  const sCy = getColY(srcRect, srcColIdx);
  const tCy = getColY(tgtRect, tgtColIdx);
  const sCx = srcRect.x + srcRect.w / 2;
  const tCx = tgtRect.x + tgtRect.w / 2;
  const padObs = obstacles.map(o => ({ x: o.x - 8, y: o.y - 8, w: o.w + 16, h: o.h + 16 }));
  const candidates = [];
  candidates.push({ points: [{ x: srcRect.x + srcRect.w, y: sCy }, { x: (srcRect.x + srcRect.w + tgtRect.x) / 2, y: sCy }, { x: (srcRect.x + srcRect.w + tgtRect.x) / 2, y: tCy }, { x: tgtRect.x, y: tCy }]});
  candidates.push({ points: [{ x: srcRect.x, y: sCy }, { x: (srcRect.x + tgtRect.x + tgtRect.w) / 2, y: sCy }, { x: (srcRect.x + tgtRect.x + tgtRect.w) / 2, y: tCy }, { x: tgtRect.x + tgtRect.w, y: tCy }]});
  candidates.push({ points: [{ x: sCx, y: srcRect.y + srcRect.h }, { x: sCx, y: (srcRect.y + srcRect.h + tgtRect.y) / 2 }, { x: tCx, y: (srcRect.y + srcRect.h + tgtRect.y) / 2 }, { x: tCx, y: tgtRect.y }]});
  candidates.push({ points: [{ x: sCx, y: srcRect.y }, { x: sCx, y: (srcRect.y + tgtRect.y + tgtRect.h) / 2 }, { x: tCx, y: (srcRect.y + tgtRect.y + tgtRect.h) / 2 }, { x: tCx, y: tgtRect.y + tgtRect.h }]});
  if (obstacles.length > 0) {
    const aboveY = Math.min(srcRect.y, tgtRect.y, ...obstacles.map(o => o.y)) - 50;
    const belowY = Math.max(srcRect.y + srcRect.h, tgtRect.y + tgtRect.h, ...obstacles.map(o => o.y + o.h)) + 50;
    const rightX = Math.max(srcRect.x + srcRect.w, tgtRect.x + tgtRect.w, ...obstacles.map(o => o.x + o.w)) + 50;
    const leftX = Math.min(srcRect.x, tgtRect.x, ...obstacles.map(o => o.x)) - 50;
    candidates.push({ points: [{ x: sCx, y: srcRect.y }, { x: sCx, y: aboveY }, { x: tCx, y: aboveY }, { x: tCx, y: tgtRect.y }]});
    candidates.push({ points: [{ x: sCx, y: srcRect.y + srcRect.h }, { x: sCx, y: belowY }, { x: tCx, y: belowY }, { x: tCx, y: tgtRect.y + tgtRect.h }]});
    candidates.push({ points: [{ x: srcRect.x + srcRect.w, y: sCy }, { x: rightX, y: sCy }, { x: rightX, y: tCy }, { x: tgtRect.x, y: tCy }]});
    candidates.push({ points: [{ x: srcRect.x, y: sCy }, { x: leftX, y: sCy }, { x: leftX, y: tCy }, { x: tgtRect.x + tgtRect.w, y: tCy }]});
  }
  let best = null, bestScore = Infinity;
  for (const c of candidates) {
    let score = 0;
    for (const obs of padObs) { if (pathCrossesRect(c.points, obs)) score += 1000; }
    score += pathLength(c.points);
    if (score < bestScore) { bestScore = score; best = c.points; }
  }
  return best;
}

function pointsToAngularPath(points) {
  if (points.length < 2) return '';
  let d = `M ${points[0].x},${points[0].y}`;
  for (let i = 1; i < points.length; i++) d += ` L ${points[i].x},${points[i].y}`;
  return d;
}

function convertEntitiesToTables(entities, relations) {
  return entities.map(e => ({
    ...e,
    refs: relations.filter(r => r.sourceId === e.id).map(r => {
      const tgt = entities.find(en => en.id === r.targetId);
      return { column: '', refTable: tgt ? tgt.name : '', refColumn: '', cardinality: r.cardinality || 'M:1' };
    })
  }));
}

function ColumnBadge({ col, entityId, entityName, activeRel, hoveredRel, relInfo, pulseRel }) {
  const typeColor = { INT:'#6366f1', BIGINT:'#6366f1', SMALLINT:'#6366f1', TINYINT:'#6366f1', VARCHAR:'#22c55e', CHAR:'#22c55e', TEXT:'#22c55e', MEDIUMTEXT:'#22c55e', LONGTEXT:'#22c55e', BOOLEAN:'#f59e0b', DATE:'#06b6d4', DATETIME:'#06b6d4', TIMESTAMP:'#06b6d4', FLOAT:'#ec4899', DOUBLE:'#ec4899', DECIMAL:'#ec4899', BLOB:'#8b5cf6', ENUM:'#f97316', UUID:'#14b8a6', JSON:'#84cc16' };
  const constraintMeta = col.pk ? { color: '#d29922', label: 'PK' } : col.uq ? { color: '#58a6ff', label: 'UQ' } : { color: null, label: '' };
  const accentColor = col.pk ? '#d29922' : col.fk ? '#a371f7' : col.uq ? '#58a6ff' : null;
  const highlightKey = activeRel || hoveredRel;
  const isHighlight = highlightKey && (
    (relInfo[highlightKey]?.refEntityId === entityId && relInfo[highlightKey]?.refCol === col.name) ||
    (relInfo[highlightKey]?.fkEntityId === entityId && relInfo[highlightKey]?.fkCol === col.name)
  );
  const tc = typeColor[col.type] || '#8b949e';
  return (
    <div data-col-badge="true"       className={`flex items-center gap-2.5 px-3 border-b border-[rgba(33,38,45,0.4)] last:border-b-0 transition-all duration-150 ${isHighlight ? 'bg-[#1f6feb]/12' : 'hover:bg-[rgba(28,35,51,0.45)] hover:border-l-[#58a6ff]/40'}`}
      style={{ height: 34, borderLeft: '2px solid transparent' }}>
      <span className="text-[10px] font-mono font-semibold px-2 rounded-md leading-none tracking-tight"
        style={{
          color: isHighlight ? '#ffffff' : tc,
          background: isHighlight ? 'rgba(255,255,255,0.2)' : `${tc}12`,
          border: `1px solid ${isHighlight ? 'rgba(255,255,255,0.3)' : `${tc}25`}`,
          boxShadow: isHighlight ? '0 0 8px rgba(255,255,255,0.1)' : 'none'
        }}>{col.type}</span>
      <span className={`text-[13px] font-medium flex-1 truncate ${isHighlight ? 'text-white' : 'text-[#c9d1d9]'}`}>{col.name || <span className="text-[#6e7681] italic">sin nombre</span>}</span>
      <div className="flex items-center gap-1 shrink-0">
        {constraintMeta.label && (
          <span className="text-[9px] font-bold px-1.5 py-[1.5px] rounded-full leading-none"
            style={{
              color: constraintMeta.color,
              background: `${constraintMeta.color}18`,
              border: `1px solid ${constraintMeta.color}35`
            }}>{constraintMeta.label}</span>
        )}
        {col.fk && !col.pk && (
          <span className="text-[9px] font-bold px-1.5 py-[1.5px] rounded-full leading-none"
            style={{
              color: '#a371f7',
              background: '#a371f718',
              border: '1px solid #a371f735'
            }}>FK</span>
        )}
        {col.nn && (
          <span className="text-[9px] font-bold px-1.5 py-[1.5px] rounded-full leading-none"
            style={{
              color: '#f85149',
              background: '#f8514918',
              border: '1px solid #f8514935'
            }}>NN</span>
        )}
        {col.ai && (
          <span className="text-[9px] font-bold px-1.5 py-[1.5px] rounded-full leading-none"
            style={{
              color: '#3fb950',
              background: '#3fb95018',
              border: '1px solid #3fb95035'
            }}>AI</span>
        )}
      </div>
    </div>
  );
}

const EntityCard = React.forwardRef(({ entity, position, selected, onSelect, onDragStart, onDelete, onAddColumn, activeRel, hoveredRel, relInfo, pulseRel, relationMode, isRelSrc, isRelTgt, categories }, ref) => {
  const c = entity.color || '#6366f1';
  const catColor = categories && categories.length > 0 ? categories[0].color : null;
  return (
    <div ref={ref} className={`table-card absolute rounded-lg overflow-hidden w-[310px] ${isRelSrc ? 'relation-source' : isRelTgt ? 'relation-target' : ''}`}
      onClick={relationMode ? (e) => { e.stopPropagation(); onSelect(entity.id); } : undefined}
      style={{
        left: position.x, top: position.y,
        background: 'linear-gradient(180deg, rgba(22,27,34,0.88) 0%, rgba(13,17,23,0.94) 100%)',
        backdropFilter: 'blur(8px)',
        WebkitBackdropFilter: 'blur(8px)',
        border: '1px solid',
        borderColor: selected ? (catColor || c) + '99' : (catColor || 'rgba(48,54,61,0.6)'),
        borderLeftWidth: catColor ? '4px' : '3px',
        borderLeftColor: catColor || c + (selected ? 'cc' : '80'),
        boxShadow: selected ? `0 0 0 1px ${catColor || c}60, 0 12px 40px rgba(0,0,0,0.5), 0 4px 12px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.06)` : '0 8px 30px rgba(0,0,0,0.4), 0 2px 8px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.05)',
        borderBottom: `2px solid ${catColor || c}${selected ? '80' : '30'}`
      }}>
      <div className="flex items-center justify-between px-3.5 py-2.5 cursor-grab active:cursor-grabbing select-none"
        style={{ background: catColor ? `linear-gradient(180deg, ${catColor}25, ${catColor}05)` : `linear-gradient(180deg, ${c}25, ${c}05)`, borderBottom: `1px solid ${catColor || c}35` }}
        onMouseDown={(e) => onDragStart(e, entity.id)}>
        <div className="flex items-center gap-2 min-w-0">
          <div className="w-[10px] h-[10px] rounded-sm shrink-0" style={{ backgroundColor: c, boxShadow: `0 0 8px ${c}50` }} />
          <h3 className="text-sm font-semibold text-[#e6edf3] truncate">{entity.name || <span className="text-[#6e7681] italic">sin nombre</span>}</h3>
          {categories && categories.length > 0 && (
            <div className="flex gap-1 ml-1">
              {categories.map((cat, i) => (
                <span key={i} className="text-[9px] font-bold px-1.5 py-0.5 rounded-full leading-none text-white" style={{ backgroundColor: cat.color, textShadow: '0 1px 2px rgba(0,0,0,0.5)' }} title={cat.name}>
                  {cat.name.charAt(0).toUpperCase()}
                </span>
              ))}
            </div>
          )}
        </div>
        <div className="flex items-center gap-1 shrink-0">
          <span className="text-[11px] text-[#6e7681] font-medium">{entity.columns.length} col.</span>
          {selected && (
            <button onClick={e => { e.stopPropagation(); onDelete(entity.id); }} className="text-[#f85149] rounded p-1">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
            </button>
          )}
        </div>
      </div>
      <div>
        {entity.columns.length === 0 ? (
          <div className="px-3 py-4 text-center" style={{ background: 'rgba(13,17,23,0.3)' }}><p className="text-[12px] text-[#6e7681] italic">Sin columnas</p></div>
        ) : (
          entity.columns.map(col => <ColumnBadge key={col.id} col={col} entityId={entity.id} entityName={entity.name} activeRel={activeRel} hoveredRel={hoveredRel} relInfo={relInfo} pulseRel={pulseRel} />)
        )}
      </div>
      {selected && (
        <div className="px-2 py-1.5 border-t border-[rgba(48,54,61,0.5)]" style={{ background: 'rgba(13,17,23,0.7)' }}>
          <button onClick={e => { e.stopPropagation(); onAddColumn(entity.id); }}
            className="w-full text-[11px] font-medium text-[#c9d1d9] bg-[#1f6feb]/15 hover:bg-[#1f6feb]/25 rounded py-1.5 border border-[#58a6ff]/25 transition-colors">+ Columna</button>
        </div>
      )}
    </div>
  );
});

function ColumnEditor({ col, onUpdate, onDelete }) {
  const [local, setLocal] = useState({ ...col });
  useEffect(() => setLocal({ ...col }), [col]);
  const sync = useCallback((upd) => { const n = { ...local, ...upd }; setLocal(n); onUpdate(col.id, n); }, [col.id, local, onUpdate]);
  return (
    <div className="px-3 py-1.5 flex items-center gap-1.5 hover:bg-[#21262d]/30 border-b border-[#30363d]/20 last:border-b-0">
      <input value={local.name} onChange={e => sync({ name: e.target.value })} placeholder="col" className="w-28 bg-[#21262d] text-[12px] text-[#c9d1d9] rounded border border-[#30363d] px-2 py-1.5 focus:ring-1 focus:ring-[#58a6ff] focus:outline-none placeholder:text-[#6e7681]" />
      <select value={local.type} onChange={e => sync({ type: e.target.value })} className="w-[90px] bg-[#21262d] text-[12px] text-[#c9d1d9] rounded border border-[#30363d] px-1 py-1.5 focus:ring-1 focus:ring-[#58a6ff] focus:outline-none">
        {COLUMN_TYPES.map(t => <option key={t} value={t}>{t}</option>)}
      </select>
      {['VARCHAR','CHAR'].includes(local.type) && (
        <input type="number" value={local.length || (local.type === 'CHAR' ? 1 : 255)} onChange={e => sync({ length: parseInt(e.target.value) || (local.type === 'CHAR' ? 1 : 255) })} className="w-10 bg-[#21262d] text-[11px] text-[#c9d1d9] rounded border border-[#30363d] px-1 py-1 focus:ring-1 focus:ring-[#58a6ff] focus:outline-none text-center" title="Longitud" />
      )}
      {local.type === 'ENUM' && (
        <input value={local.values || ''} onChange={e => sync({ values: e.target.value })} placeholder="a,b,c" className="w-16 bg-[#21262d] text-[11px] text-[#c9d1d9] rounded border border-[#30363d] px-1 py-1 focus:ring-1 focus:ring-[#58a6ff] focus:outline-none placeholder:text-[#6e7681] text-center" title="Valores" />
      )}
      {['DECIMAL','FLOAT','DOUBLE'].includes(local.type) && (
        <input type="number" value={local.length || 10} onChange={e => sync({ length: parseInt(e.target.value) || 10 })} className="w-10 bg-[#21262d] text-[11px] text-[#c9d1d9] rounded border border-[#30363d] px-1 py-1 focus:ring-1 focus:ring-[#58a6ff] focus:outline-none text-center" title="Precisión" />
      )}
      <div className="flex gap-px ml-auto">
        {[{k:'pk',l:'PK'},{k:'ai',l:'AI'},{k:'nn',l:'NN'},{k:'uq',l:'UQ'}].map(({k,l}) => (
          <button key={k} onClick={() => { const nv = !local[k]; const upd = { [k]: nv }; if (k === 'pk' && nv) upd.fk = false; sync(upd); }}
            className={`text-[9px] font-bold px-1.5 py-1 rounded border leading-none min-w-[22px] ${local[k] ? BTN_STYLES[k] : 'bg-[#21262d] border-[#30363d] text-[#6e7681] hover:border-[#484f58]'}`}>{l}</button>
        ))}
        <button onClick={() => onDelete(col.id)} className="text-[#6e7681] hover:text-[#f85149] p-1 rounded hover:bg-[#f85149]/10 ml-0.5">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
    </div>
  );
}

function RelationConfig({ relation, entities, onUpdate, onDelete, onClose, linePaths, onResetLinePath, onUndoLinePath }) {
  const src = entities.find(e => e.id === relation.sourceId);
  const tgt = entities.find(e => e.id === relation.targetId);
  return (
    <div className="absolute top-4 left-4 bg-[#21262d]/95 backdrop-blur-sm border border-[#30363d]/60 rounded-xl p-3 shadow-2xl z-20 min-w-[260px]">
      <div className="flex items-center gap-2 mb-2">
        <span className="text-[12px] text-[#6e7681]">Relación</span>
        <div className="flex-1" />
