                <span className="text-[11px] text-[#6e7681] shrink-0">Ruta:</span>
                <button onClick={e => { e.stopPropagation(); onResetLinePath(key); }}
                  className="text-[10px] font-bold px-2 py-1 rounded border bg-[#f85149]/20 border-[#f85149]/50 text-[#f85149]"
                  title="Restaurar ruta automática">&times; Auto</button>
              </div>
            )}
          </div>
        );
      })()}
      {tables.length > 0 && (
        <div className="absolute bottom-4 right-4 flex items-center gap-1.5 bg-[#21262d]/90 border border-[#30363d]/60 rounded-xl p-2 shadow-lg z-20">
          <button onClick={fitToScreen} className="text-[#8b949e] bg-[#30363d]/50 rounded-lg w-9 h-9 flex items-center justify-center" title="Ajustar al contenedor">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          </button>
          <button onClick={() => onPositionsChange(null, null, -0.1)} className="text-[#8b949e] bg-[#30363d]/50 rounded-lg w-9 h-9 flex items-center justify-center text-lg font-bold">-</button>
          <span className="text-[12px] text-[#8b949e] w-12 text-center font-mono">{Math.round(zoom * 100)}%</span>
          <button onClick={() => onPositionsChange(null, null, 0.1)} className="text-[#8b949e] bg-[#30363d]/50 rounded-lg w-9 h-9 flex items-center justify-center text-lg font-bold">+</button>
        </div>
      )}
    </div>
  );
}

const DEMO_SQL = `CREATE TABLE clientes (
  id INT PRIMARY KEY AUTO_INCREMENT,
  nombre VARCHAR(100) NOT NULL,
  email VARCHAR(255) UNIQUE,
  telefono VARCHAR(20),
  fecha_registro DATE,
  activo BOOLEAN DEFAULT TRUE
);

CREATE TABLE categorias (
  id INT PRIMARY KEY AUTO_INCREMENT,
  nombre VARCHAR(100) NOT NULL,
  descripcion TEXT
);

CREATE TABLE productos (
  id INT PRIMARY KEY AUTO_INCREMENT,
  nombre VARCHAR(200) NOT NULL,
  precio DECIMAL(10,2) NOT NULL,
  stock INT DEFAULT 0,
  categoria_id INT,
  FOREIGN KEY (categoria_id) REFERENCES categorias(id)
);

CREATE TABLE pedidos (
  id INT PRIMARY KEY AUTO_INCREMENT,
  cliente_id INT NOT NULL,
  fecha DATETIME,
  total DECIMAL(10,2),
  estado VARCHAR(20) DEFAULT 'pendiente',
  FOREIGN KEY (cliente_id) REFERENCES clientes(id)
);

CREATE TABLE pedido_productos (
  id INT PRIMARY KEY AUTO_INCREMENT,
  pedido_id INT NOT NULL,
  producto_id INT NOT NULL,
  cantidad INT NOT NULL,
  precio_unitario DECIMAL(10,2),
  FOREIGN KEY (pedido_id) REFERENCES pedidos(id),
  FOREIGN KEY (producto_id) REFERENCES productos(id)
);`;

function App() {
  const [sql] = useState(DEMO_SQL);
  const [tables, setTables] = useState([]);
  const [selectedTables, setSelectedTables] = useState({});
  const [zoom, setZoom] = useState(1);
  const [positions, setPositions] = useState({});
  const [linePaths, setLinePaths] = useState({});
  const [fitKey, setFitKey] = useState(0);

  useEffect(() => {
    try {
      const clean = stripSQLComments(sql);
      if (!clean.trim()) return;
      const parsed = parseSQL(clean);
      if (parsed.length === 0) return;
      const sorted = sortTablesByRelations(parsed);
      setPositions(autoLayout(sorted));
      setTables(sorted);
      setFitKey(k => k + 1);
    } catch (e) {}
  }, []);

  const handlePositionChange = useCallback((tid, key, val) => {
    if (tid === null && key === null) {
      if (typeof val === 'number') { setZoom(z => Math.max(0.25, Math.min(3, z + val))); return; }
      if (val && typeof val === 'object' && val.abs !== undefined) { setZoom(Math.max(0.25, Math.min(3, val.abs))); return; }
      return;
    }
    setPositions(prev => {
      if (!prev[tid]) return prev;
      return { ...prev, [tid]: { x: key, y: val } };
    });
  }, []);

  const handleLinePathChange = useCallback((key, points) => {
    setLinePaths(prev => ({ ...prev, [key]: points }));
  }, []);

  const handleResetLinePath = useCallback((key) => {
    setLinePaths(prev => { const next = { ...prev }; delete next[key]; return next; });
  }, []);

  const handleSelectTable = useCallback((id, ctrlKey) => {
    if (id === null) { setSelectedTables({}); return; }
    setSelectedTables(prev => {
      if (ctrlKey) { const next = { ...prev }; if (next[id]) { delete next[id]; return next; } next[id] = true; return next; }
      return { [id]: true };
    });
  }, []);

  const arrSql = useMemo(() => {
    const lines = sql.split('\n');
    return { text: sql, lines: lines.length };
  }, [sql]);

  const sqlHtml = useMemo(() => highlightSql(sql), [sql]);

  return (
    <div className="h-screen flex flex-col bg-[#0d1117] overflow-hidden">
      <header className="bg-[#161b22]/80 px-5 py-3 flex items-center justify-between shrink-0 border-b border-[#21262d]/50">
        <div className="flex items-center gap-3">
          <div className="bg-[#1f6feb]/20 rounded-lg p-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" className="text-[#58a6ff]">
              <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
            </svg>
          </div>
          <h1 className="text-lg font-bold text-[#c9d1d9]">Diagram Generator &mdash; Demo</h1>
        </div>
        <div className="flex items-center gap-1.5">
          {tables.length > 0 && (
            <div className="flex bg-[#21262d]/80 rounded-lg border border-[#30363d]/50">
              <button data-export="png" onClick={() => exportPNG(`demo-diagrama-${Date.now()}.png`)}
                className="text-[12px] font-medium px-2.5 h-8 text-[#8b949e] hover:text-[#c9d1d9] hover:bg-[#30363d]/50 border-r border-[#30363d]/50 flex items-center gap-1.5 transition-colors rounded-l-lg shadow-md" title="Exportar PNG">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                PNG
              </button>
              <button data-export="pdf" onClick={() => exportPDF(`demo-diagrama-${Date.now()}.pdf`)}
                className="text-[12px] font-medium px-2.5 h-8 text-[#8b949e] hover:text-[#c9d1d9] hover:bg-[#30363d]/50 flex items-center gap-1.5 transition-colors rounded-r-lg shadow-md" title="Exportar PDF">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                PDF
              </button>
            </div>
          )}
          <span className="text-[11px] text-[#6e7681] font-mono ml-2">{tables.length} tablas</span>
        </div>
      </header>

      <div className="flex-1 flex overflow-hidden">
        <div className="w-[420px] overflow-hidden shrink-0 border-r border-[#21262d]/50 bg-[#161b22]/30 flex flex-col">
          <div className="p-2.5 flex flex-col h-full">
            <div className="flex items-center gap-1 mb-2 shrink-0 border-b border-[#30363d]/40 pb-2.5">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" className="text-[#58a6ff]"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              <span className="text-[11px] font-medium text-[#8b949e]">SQL de ejemplo</span>
              <span className="text-[10px] text-[#484f58] ml-auto">{arrSql.lines} líneas</span>
            </div>
            <div className="flex-1 relative min-h-0">
              <div className="absolute inset-0 bg-[#0d1117] rounded-lg border border-[#30363d] overflow-auto">
                <pre className="p-4 m-0 text-[12px] leading-relaxed text-[#c9d1d9] whitespace-pre-wrap break-all bg-transparent select-text"
                  style={{ fontFamily: "'SF Mono', 'Fira Code', 'Cascadia Code', 'Consolas', monospace" }}
                  dangerouslySetInnerHTML={{ __html: sqlHtml || '&nbsp;' }} />
              </div>
            </div>
          </div>
        </div>

        <div className="flex-1 flex flex-col overflow-hidden">
          <div className="flex-1 relative diagram-container overflow-hidden">
            <Diagram
              tables={tables}
              selectedTables={selectedTables}
              onSelectTable={handleSelectTable}
              onPositionsChange={handlePositionChange}
              positions={positions}
              zoom={zoom}
              linePaths={linePaths}
              onUpdateLinePath={handleLinePathChange}
              onResetLinePath={handleResetLinePath}
              fitKey={fitKey}
            />
          </div>
        </div>
      </div>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App />);
</script>
</body>
</html>